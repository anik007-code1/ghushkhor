# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# NEXT_PUBLIC_SITE_URL or SITE_URL: The production canonical domain for SEO, sitemaps, Open Graph, and robots.txt
# Example: https://ghushkhur.com or https://example.com
SITE_URL="https://example.com"
NEXT_PUBLIC_SITE_URL="https://example.com"

# GOOGLE_SITE_VERIFICATION: Google Search Console verification meta tag token
# Example: "abc123xyz-verification-token"
GOOGLE_SITE_VERIFICATION=""

# ADSENSE_PUBLISHER_ID: Google AdSense Publisher Account ID
# Example: "ca-pub-1234567890123456"
ADSENSE_PUBLISHER_ID=""

# ENABLE_ADS: Set to true once AdSense is approved. Defaults to false.
ENABLE_ADS="false"

# ADMIN_USERNAME: Username for /admin moderation portal
ADMIN_USERNAME=

# ADMIN_PASSWORD: Password for /admin moderation portal
ADMIN_PASSWORD=

